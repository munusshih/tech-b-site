---
import BaseHead from "@/components/BaseHead.astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  year?: number;
}

const { title, description, image = "/opengraph.jpg", year } = Astro.props;
---

<!doctype html>
<html lang="en" data-course-year={year}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="border-b">
    <slot />
    <Analytics />
    <script>
      import "../scripts/page-animations.js";
    </script>
    <script src="/scripts/external-links.js" is:inline></script>
  </body>
</html>
