---
import BaseHead from "@/components/BaseHead.astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  year?: number;
}

const { title, description, image = "/opengraph.jpg", year } = Astro.props;
---

<!doctype html>
<html lang="en" data-course-year={year}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="border-b">
    <slot />
    <Analytics />
    <script>
      import "../scripts/page-animations.js";
    </script>
    <script src="/scripts/external-links.js" is:inline></script>
  </body>
</html>
