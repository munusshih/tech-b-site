---
import BaseHead from "@/components/BaseHead.astro";
import ImageDitherFilter from "@/components/ImageDitherFilter.astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  year?: number;
}

const { title, description, image = "/opengraph.jpg", year } = Astro.props;
const shouldTrackAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" data-course-year={year}>
  <head>
    <BaseHead title={title} description={description} image={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="border-b">
    <ImageDitherFilter />
    <slot />
    {shouldTrackAnalytics && <Analytics />}
    <script>
      import "../scripts/code-copy.js";
      import "../scripts/page-animations.js";
    </script>
    <script src="/scripts/external-links.js" is:inline></script>
  </body>
</html>
