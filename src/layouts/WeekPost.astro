---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "@/components/BaseHead.astro";
import CourseTitle from "@/components/CourseTitle.astro";
import Footer from "@/components/Footer.astro";
import ImageDitherFilter from "@/components/ImageDitherFilter.astro";
import Nav from "@/components/Nav.astro";
import Analytics from "@vercel/analytics/astro";
import StudentResponses from "@/components/StudentResponses.astro";
import ArchiveNotice from "@/components/ArchiveNotice.astro";
import WeekTldr from "@/components/WeekTldr.astro";
import "@/styles/lectures.css";
import { getYearBasePath, getYearConfig, isArchivedYear } from "@/config";
import { disableSubmissionLinks } from "@/lib/course-content";
import { marked } from "marked";

type Props = CollectionEntry<"weeks">["data"] & {
  year: number;
  contentId?: string;
};

const {
  title,
  description,
  week,
  longDescription,
  tldr,
  heroImage,
  heroImageAlt,
  year,
} = Astro.props;
const config = getYearConfig(year);
const archived = isArchivedYear(year);
const basePath = getYearBasePath(year);
const longDescriptionHTML = longDescription
  ? await marked(longDescription)
  : null;
const tldrHTML = tldr ? await marked(tldr) : null;
const rawSlotContent = await Astro.slots.render("default");

type OutlineItem = {
  id: string;
  level: 2 | 3;
  title: string;
};

type OutlineSection = {
  heading: OutlineItem;
  children: OutlineItem[];
};

function cleanHeadingText(value: string): string {
  return value
    .replace(/<[^>]*>/g, "")
    .replaceAll("&amp;", "&")
    .replaceAll("&quot;", '"')
    .replaceAll("&#39;", "'")
    .replaceAll("&lt;", "<")
    .replaceAll("&gt;", ">")
    .trim();
}

function headingSlug(value: string): string {
  return cleanHeadingText(value)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

function addHeadingAnchors(html: string): {
  content: string;
  outline: OutlineItem[];
} {
  const outline: OutlineItem[] = [];
  const slugCounts = new Map<string, number>();
  const content = html.replace(
    /<h([23])([^>]*)>(.*?)<\/h\1>/gi,
    (heading, rawLevel, rawAttributes, innerHTML) => {
      const level = Number(rawLevel) as 2 | 3;
      const title = cleanHeadingText(innerHTML);
      const existingId = rawAttributes.match(/\sid=["']([^"']+)["']/i)?.[1];
      const baseId = existingId || headingSlug(title) || `section-${level}`;
      const seen = slugCounts.get(baseId) || 0;
      const id = seen === 0 ? baseId : `${baseId}-${seen + 1}`;
      slugCounts.set(baseId, seen + 1);
      outline.push({ id, level, title });

      if (existingId) return heading;
      return `<h${level}${rawAttributes} id="${id}">${innerHTML}</h${level}>`;
    },
  );

  return { content, outline };
}

function groupOutlineItems(items: OutlineItem[]): OutlineSection[] {
  const sections: OutlineSection[] = [];

  for (const item of items) {
    if (item.level === 2 || sections.length === 0) {
      sections.push({ heading: item, children: [] });
      continue;
    }

    sections.at(-1)?.children.push(item);
  }

  return sections;
}

function resolveCourseLinks(html: string): string {
  const links = {
    assignmentFormUrl: config.submissionLinks.assignmentFormUrl,
    projectFormUrl: config.submissionLinks.projectFormUrl,
    bioFormUrl: config.submissionLinks.bioFormUrl,
  };
  return Object.entries(links).reduce((content, [token, url]) => {
    const replacement = url || "#submission-link-not-configured";
    return content
      .replaceAll(`{{${token}}}`, replacement)
      .replaceAll(`%7B%7B${token}%7D%7D`, encodeURI(replacement));
  }, html);
}

function wrapContentSections(html: string): string {
  const h2Regex = /(<h2[^>]*>.*?<\/h2>)/gi;
  const parts = html.split(h2Regex);
  let result = "";
  let currentSection = "";
  let hasHeading = false;

  function renderSection(content: string, sectionHasHeading: boolean): string {
    const sectionClass = sectionHasHeading
      ? "content-section"
      : "content-section intro-section";
    let dataSection = "";

    if (sectionHasHeading) {
      const h2Match = content.match(/<h2[^>]*>(.*?)<\/h2>/i);
      if (h2Match) {
        const sectionId = h2Match[1]
          .replace(/<[^>]*>/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");
        dataSection = ` data-section="${sectionId}"`;
      }
    }

    return `<div class="${sectionClass}"${dataSection}>${content}</div>\n`;
  }

  for (const rawPart of parts) {
    const part = rawPart.trim();
    if (!part) continue;
    if (/^<h2[\s>]/i.test(part)) {
      if (currentSection) {
        result += renderSection(currentSection, hasHeading);
      }
      currentSection = part;
      hasHeading = true;
    } else {
      currentSection += part;
    }
  }

  if (currentSection) {
    result += renderSection(currentSection, hasHeading);
  }
  return result;
}

const { content: anchoredContent, outline: pageOutline } =
  addHeadingAnchors(rawSlotContent);
const groupedPageOutline = groupOutlineItems(pageOutline);
const linkedContent = resolveCourseLinks(anchoredContent);
const processedContent = wrapContentSections(
  archived ? disableSubmissionLinks(linkedContent) : linkedContent,
);
const shouldTrackAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" data-course-year={year}>
  <head>
    <BaseHead
      title={`Week ${week}: ${title}`}
      description={description}
      image="/opengraph.jpg"
    />
  </head>
  <body>
    <ImageDitherFilter />
    <header id="week-header">
      <div>
        <a href={`${basePath}/`}>
          <CourseTitle year={year} />
        </a>
        <h2 class="heading-1">Week {week}</h2>
        {archived && <ArchiveNotice year={year} />}
        {
          longDescriptionHTML && (
            <div class="long-description" set:html={longDescriptionHTML} />
          )
        }
        <nav class="weekly-schedule"><Nav year={year} /></nav>
        {
          pageOutline.length > 0 && (
            <nav class="week-toc" aria-label={`Week ${week} page sections`}>
              <h1 class="sidebar-section-title">On This Page</h1>
              <ol>
                <li class="toc-level-2">
                  <a href="#week-content">Week {week} overview</a>
                </li>
                {groupedPageOutline.map(({ heading, children }) => (
                  <li class={`toc-level-${heading.level}`}>
                    {children.length > 0 ? (
                      <details>
                        <summary>
                          <a class="toc-heading-link" href={`#${heading.id}`}>
                            {heading.title}
                          </a>
                          <span class="toc-disclosure" aria-hidden="true" />
                        </summary>
                        <ol class="toc-subsections">
                          {children.map((item) => (
                            <li class="toc-level-3">
                              <a href={`#${item.id}`}>{item.title}</a>
                            </li>
                          ))}
                        </ol>
                      </details>
                    ) : (
                      <a href={`#${heading.id}`}>{heading.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="week-sidebar-responses">
          <StudentResponses year={year} week={week} />
        </div>
      </div>
      <div class="week-sidebar-meta">
        <Footer year={year} />
      </div>
    </header>

    <main id="week-content" class="week-main-content">
      <h1 class="heading-1">{title}</h1>
      {
        heroImage && (
          <figure class:list={["week-hero", tldrHTML && "week-hero--has-tldr"]}>
            <Image
              src={heroImage}
              alt={heroImageAlt || `Week ${week}: ${title}`}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
      {
        tldrHTML && (
          <WeekTldr>
            <Fragment set:html={tldrHTML} />
          </WeekTldr>
        )
      }
      <Fragment set:html={processedContent} />
    </main>
    {shouldTrackAnalytics && <Analytics />}
    <script>
      import "../scripts/code-copy.js";
      import "../scripts/page-animations.js";
    </script>
    <script src="/scripts/external-links.js" is:inline></script>
  </body>
</html>
