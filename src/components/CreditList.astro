---
import { formatCreditText } from "@/lib/credit-format";

interface Props {
  value: string;
}

const { value } = Astro.props;
const segments = formatCreditText(value);
---

{
  segments.length > 0 && (
    <section class="credits" aria-label="Credits and references">
      <h3>Credits &amp; References</h3>
      <p class="credits__copy">
        {segments.map((segment) =>
          segment.type === "link" ? (
            <a
              href={segment.url}
              target="_blank"
              rel="noopener noreferrer"
              title={segment.url}
              aria-label={`Open ${segment.label}`}
            >
              {segment.text}
            </a>
          ) : (
            segment.value
          ),
        )}
      </p>
    </section>
  )
}

<style>
  .credits {
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
    border-top: 1px solid currentColor;
    padding-top: 0.7rem;
  }

  .credits h3 {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .credits__copy {
    margin: 0.8rem 0 0;
    max-width: none;
    font-size: 0.9rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .credits__copy a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .credits__copy a::after {
    display: none;
    content: none;
  }

  .credits__copy a:hover,
  .credits__copy a:focus-visible {
    opacity: 0.65;
  }
</style>
