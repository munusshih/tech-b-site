---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import CourseInfo from "@/components/CourseInfo.astro";
import YearBackground from "@/components/YearBackground.astro";
import CourseTitle from "@/components/CourseTitle.astro";
import HallofFame from "@/components/HallofFame.astro";
import Marquee from "@/components/Marquee.astro";
import YearSwitcher from "@/components/YearSwitcher.astro";
import ArchiveNotice from "@/components/ArchiveNotice.astro";
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  getYearConfig,
  isArchivedYear,
} from "@/config";

interface Props {
  year: number;
}

const { year } = Astro.props;
const yearConfig = getYearConfig(year);
const archived = isArchivedYear(year);
const courseHeading = yearConfig.sectionId
  ? `${SITE_TITLE} (${yearConfig.sectionId})`
  : SITE_TITLE;
const marqueeText =
  yearConfig.marqueeText?.trim() ||
  `Hello!`;
---

<Layout title={courseHeading} description={SITE_DESCRIPTION} year={year}>
  <YearBackground year={year} />
  <header>
    <div>
      <CourseTitle year={year} />
      <p>{SITE_DESCRIPTION}</p>
      <YearSwitcher year={year} />
      {archived && <ArchiveNotice year={year} />}
    </div>
    <CourseInfo year={year} />
  </header>

  <main class="cutoff homepage-weekly-schedule">
    <Nav year={year} />
  </main>

  <div id="third-column" class="border-t">
    <HallofFame year={year} />
    <Footer year={year} />
  </div>
  <Marquee text={marqueeText} speed="slow" direction="right" />
</Layout>
