---
// 2026 uses a signal-flow field. The 2025 orbital sketch remains untouched.
---

<div id="p5-background" aria-hidden="true"></div>

<script is:client>
  /* eslint-disable no-undef, @typescript-eslint/no-unused-vars */

  const YEAR_SEED = 2026;
  const TRAIL_LENGTH = 34;
  const COLORS = [
    [112, 255, 190],
    [75, 190, 255],
    [225, 255, 145],
    [235, 235, 235],
  ];

  let streams = [];
  let canvas;

  class SignalStream {
    constructor(index) {
      this.index = index;
      this.reset(false);
    }

    reset(fromEdge = true) {
      if (fromEdge) {
        const edge = floor(random(4));
        if (edge === 0) {
          this.x = -10;
          this.y = random(height);
        } else if (edge === 1) {
          this.x = width + 10;
          this.y = random(height);
        } else if (edge === 2) {
          this.x = random(width);
          this.y = -10;
        } else {
          this.x = random(width);
          this.y = height + 10;
        }
      } else {
        this.x = random(width);
        this.y = random(height);
      }

      this.speed = random(0.45, 1.35);
      this.weight = random([1, 1, 1.5, 2]);
      this.offset = random(1000);
      this.color = random(COLORS);
      this.trail = [];
    }

    update() {
      const field = noise(
        this.x * 0.0022,
        this.y * 0.0022,
        frameCount * 0.0015 + this.offset,
      );
      const angle = field * TWO_PI * 3.5 + sin(frameCount * 0.004 + this.index);

      this.x += cos(angle) * this.speed;
      this.y += sin(angle) * this.speed;
      this.trail.push({ x: this.x, y: this.y });

      if (this.trail.length > TRAIL_LENGTH) this.trail.shift();
      if (this.x < -30 || this.x > width + 30 || this.y < -30 || this.y > height + 30) {
        this.reset(true);
      }
    }

    display() {
      noFill();
      strokeWeight(this.weight);
      beginShape();
      for (let i = 0; i < this.trail.length; i++) {
        const point = this.trail[i];
        const alpha = map(i, 0, this.trail.length - 1, 0, 145);
        stroke(this.color[0], this.color[1], this.color[2], alpha);
        vertex(point.x, point.y);
      }
      endShape();

      noStroke();
      fill(this.color[0], this.color[1], this.color[2], 190);
      rect(this.x, this.y, 3 + this.weight, 3 + this.weight);
    }
  }

  function streamCount() {
    return constrain(floor((windowWidth * windowHeight) / 8500), 55, 150);
  }

  function resetField() {
    randomSeed(YEAR_SEED);
    noiseSeed(YEAR_SEED);
    streams = Array.from({ length: streamCount() }, (_, index) => new SignalStream(index));
  }

  function drawSignalGrid() {
    strokeWeight(1);
    stroke(235, 235, 235, 20);
    for (let x = 48; x < width; x += 96) {
      for (let y = 48; y < height; y += 96) {
        line(x - 4, y, x + 4, y);
        line(x, y - 4, x, y + 4);
      }
    }
  }

  function drawCarrierWaves() {
    noFill();
    strokeWeight(1);
    for (let lane = 0; lane < 3; lane++) {
      const color = COLORS[lane];
      stroke(color[0], color[1], color[2], 42);
      beginShape();
      for (let x = -20; x <= width + 20; x += 18) {
        const baseY = ((lane + 1) * height) / 4;
        const y =
          baseY +
          sin(x * 0.009 + frameCount * (0.006 + lane * 0.002)) * (24 + lane * 12) +
          (noise(x * 0.004, lane * 20, frameCount * 0.001) - 0.5) * 90;
        curveVertex(x, y);
      }
      endShape();
    }
  }

  function setup() {
    canvas = createCanvas(windowWidth, windowHeight);
    canvas.parent("p5-background");
    pixelDensity(1);
    rectMode(CENTER);
    strokeCap(SQUARE);
    resetField();
  }

  function draw() {
    clear();
    drawSignalGrid();
    drawCarrierWaves();
    for (const stream of streams) {
      stream.update();
      stream.display();
    }
  }

  function mousePressed() {
    for (let i = 0; i < 10; i++) {
      const stream = new SignalStream(streams.length + i);
      stream.x = mouseX + random(-18, 18);
      stream.y = mouseY + random(-18, 18);
      stream.trail = [];
      streams.push(stream);
    }
  }

  function windowResized() {
    resizeCanvas(windowWidth, windowHeight);
    resetField();
  }
</script>

<style>
  #p5-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.58;
    z-index: -9999;
    pointer-events: none;
  }
</style>
