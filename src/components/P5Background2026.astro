---
// 2026 follows Tech B's ant-colony visual language. The 2025 sketch is separate.
---

<div id="p5-background" aria-hidden="true"></div>

<script is:client>
  /* eslint-disable no-undef, @typescript-eslint/no-unused-vars */

  const YEAR_SEED = 2026;
  const INK = [57, 45, 47];
  const PHEROMONE_LIMIT = 720;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let ants = [];
  let pheromones = [];
  let foodSources = [];
  let nest;
  let canvas;

  class Ant {
    constructor(index) {
      this.index = index;
      this.phase = random(1000);
      this.speed = random(0.65, 1.35);
      this.carrying = index % 4 === 0;
      this.foodIndex = index % foodSources.length;
      const target = this.carrying ? nest : foodSources[this.foodIndex];
      const progress = random();
      this.x = lerp(nest.x, target.x, progress) + randomGaussian(0, 28);
      this.y = lerp(nest.y, target.y, progress) + randomGaussian(0, 28);
      this.heading = atan2(target.y - this.y, target.x - this.x) + random(-0.7, 0.7);
      this.depositClock = floor(random(12));
    }

    update() {
      const target = this.carrying ? nest : foodSources[this.foodIndex];
      const desired = atan2(target.y - this.y, target.x - this.x);
      const turn = atan2(sin(desired - this.heading), cos(desired - this.heading));
      const wandering = map(noise(this.phase, frameCount * 0.006), 0, 1, -0.12, 0.12);
      this.heading += turn * 0.025 + wandering;

      const step = constrain(width / 760, 0.8, 2.15) * this.speed;
      this.x += cos(this.heading) * step;
      this.y += sin(this.heading) * step;
      this.phase += 0.008;

      const distance = dist(this.x, this.y, target.x, target.y);
      if (distance < target.radius + 10) {
        this.carrying = !this.carrying;
        if (!this.carrying) this.foodIndex = (this.foodIndex + 1 + this.index) % foodSources.length;
        this.heading += PI + random(-0.3, 0.3);
      }

      if (this.x < -20 || this.x > width + 20 || this.y < -20 || this.y > height + 20) {
        this.x = nest.x + random(-nest.radius, nest.radius);
        this.y = nest.y + random(-nest.radius, nest.radius);
        this.heading = random(TWO_PI);
      }

      this.depositClock += 1;
      if (this.depositClock >= 10 + (this.index % 9)) {
        pheromones.push({
          x: this.x,
          y: this.y,
          life: random(220, 480),
          square: this.carrying,
        });
        this.depositClock = 0;
      }
    }

    display() {
      push();
      translate(this.x, this.y);
      rotate(this.heading);
      stroke(...INK, 175);
      strokeWeight(1);
      line(-5, 0, 5, 0);
      noStroke();
      fill(...INK, 210);
      circle(-4, 0, 2.6);
      circle(0, 0, 3.4);
      circle(4, 0, 2.4);
      pop();
    }
  }

  function createScene() {
    randomSeed(YEAR_SEED);
    noiseSeed(YEAR_SEED);

    nest = {
      x: width * 0.68,
      y: height * 0.28,
      radius: constrain(min(width, height) * 0.055, 30, 68),
      label: "[BASE]",
    };

    foodSources = [
      { x: width * 0.17, y: height * 0.2, radius: 18, label: "{F:0}" },
      { x: width * 0.27, y: height * 0.74, radius: 22, label: "[DATA]" },
      { x: width * 0.82, y: height * 0.71, radius: 16, label: "<F/2>" },
    ];

    const population = constrain(floor((width * height) / 15000), 36, 90);
    pheromones = [];
    ants = Array.from({ length: population }, (_, index) => new Ant(index));
  }

  function drawNode(node, index) {
    push();
    translate(node.x, node.y);
    rotate(sin(frameCount * 0.003 + index) * 0.08);
    noFill();
    stroke(...INK, 75);
    strokeWeight(1);
    circle(0, 0, node.radius * 2);
    noStroke();
    fill(...INK, 150);
    textFont("monospace");
    textStyle(BOLD);
    textSize(constrain(width / 105, 10, 15));
    textAlign(CENTER, CENTER);
    text(node.label, 0, 0);
    pop();
  }

  function setup() {
    canvas = createCanvas(windowWidth, windowHeight);
    canvas.parent("p5-background");
    pixelDensity(1);
    frameRate(reducedMotion ? 10 : 40);
    createScene();
  }

  function draw() {
    clear();

    for (let index = pheromones.length - 1; index >= 0; index -= 1) {
      const trace = pheromones[index];
      trace.life -= reducedMotion ? 2.5 : 1;
      if (trace.life <= 0) {
        pheromones.splice(index, 1);
        continue;
      }
      const alpha = map(trace.life, 0, 480, 0, 54, true);
      noStroke();
      fill(...INK, alpha);
      if (trace.square) square(trace.x, trace.y, 2.2);
      else circle(trace.x, trace.y, 2.2);
    }

    if (pheromones.length > PHEROMONE_LIMIT) {
      pheromones.splice(0, pheromones.length - PHEROMONE_LIMIT);
    }

    drawNode(nest, 0);
    foodSources.forEach((food, index) => drawNode(food, index + 1));

    if (!reducedMotion || frameCount % 3 === 0) ants.forEach((ant) => ant.update());
    ants.forEach((ant) => ant.display());
  }

  function windowResized() {
    resizeCanvas(windowWidth, windowHeight);
    createScene();
  }
</script>

<style>
  #p5-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.82;
    z-index: -9999;
    pointer-events: none;
  }
</style>
