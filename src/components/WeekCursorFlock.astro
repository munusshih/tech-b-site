<canvas
  id="week-cursor-flock"
  class="week-cursor-flock"
  data-week-cursor-flock
  data-state="suppressed"
  data-interaction="none"
  aria-hidden="true"></canvas>

<style>
  .week-cursor-flock {
    position: fixed;
    opacity: 0;
    z-index: 1000000;
    transition: none;
    contain: strict;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .week-cursor-flock[data-state="active"] {
    opacity: 0.88;
    transition: opacity 420ms ease-out;
  }

  .week-cursor-flock[data-state="exiting"] {
    opacity: 0.88;
  }

  @media print, (prefers-reduced-motion: reduce), (forced-colors: active) {
    .week-cursor-flock {
      display: none;
    }
  }
</style>

<script>
  import "../scripts/week-cursor-flock.js";
</script>
