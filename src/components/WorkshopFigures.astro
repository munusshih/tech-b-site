---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  figures: {
    image: ImageMetadata;
    title: string;
    alt: string;
    source?: string;
    credit: string;
    wide?: boolean;
  }[];
}

const { figures } = Astro.props;
---

<div class="workshop-figures">
  {
    figures.map(({ image, title, alt, source, credit, wide }) => (
      <figure class:list={[{ wide }]} data-workshop-figure>
        <a
          class="workshop-figure-image"
          href={image.src}
          aria-label={`Open a larger image of ${title}`}
        >
          <Image src={image} alt={alt} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          {source ? <a href={source}>{title}</a> : <strong>{title}</strong>}
          <span>{credit}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .workshop-figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
    margin: 1.5rem 0 2rem;
  }

  figure {
    display: grid;
    grid-template-rows: 1fr auto;
    margin: 0;
    border: 1px solid var(--workshop-line);
    min-width: 0;
  }

  .wide,
  figure:only-child {
    grid-column: 1 / -1;
  }

  .workshop-figure-image {
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--workshop-tint);
  }

  .workshop-figure-image:hover {
    opacity: 1;
  }

  img {
    display: block;
    filter: none;
    width: 100%;
    height: auto;
    max-height: 28rem;
    object-fit: contain;
  }

  figcaption {
    border-top: 1px solid var(--workshop-line);
    padding: 0.7rem 0.85rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  figcaption :is(a, strong, span) {
    font-size: inherit;
  }

  figcaption span {
    display: block;
    color: var(--workshop-muted);
  }

  @media (max-width: 42rem) {
    .workshop-figures {
      grid-template-columns: 1fr;
    }
  }
</style>
