<div class="sketch-switcher" aria-label="Background sketch">
  <span>Sketch</span>
  <div role="radiogroup" aria-label="Choose a background sketch">
    <button type="button" data-sketch-mode="1" role="radio" aria-checked="false">
      1
      <span class="sr-only">Quantized activations</span>
    </button>
    <button type="button" data-sketch-mode="2" role="radio" aria-checked="false">
      2
      <span class="sr-only">Decision boundary</span>
    </button>
    <button type="button" data-sketch-mode="3" role="radio" aria-checked="false">
      3
      <span class="sr-only">Latent tape scanner</span>
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = "tech-b-sketch-mode";
  const validModes = ["1", "2", "3"];
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("button[data-sketch-mode]"),
  );

  function applySketchMode(mode: string, persist = true) {
    const nextMode = validModes.includes(mode) ? mode : "1";
    document.documentElement.dataset.sketchMode = nextMode;

    buttons.forEach((button) => {
      const selected = button.dataset.sketchMode === nextMode;
      button.setAttribute("aria-checked", String(selected));
      button.tabIndex = selected ? 0 : -1;
    });

    if (persist) {
      try {
        window.localStorage.setItem(STORAGE_KEY, nextMode);
      } catch {
        // Storage may be unavailable; the live selection still works.
      }
    }

    window.dispatchEvent(
      new CustomEvent("techb-sketch-change", { detail: { mode: nextMode } }),
    );
  }

  const initialMode = document.documentElement.dataset.sketchMode || "1";
  applySketchMode(initialMode, false);

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => {
      applySketchMode(button.dataset.sketchMode || "1");
    });

    button.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) {
        return;
      }
      event.preventDefault();
      const direction = ["ArrowRight", "ArrowDown"].includes(event.key) ? 1 : -1;
      const nextButton = buttons[(index + direction + buttons.length) % buttons.length];
      nextButton.focus();
      applySketchMode(nextButton.dataset.sketchMode || "1");
    });
  });
</script>

<style>
  .sketch-switcher {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: -0.6rem 0 1.25rem;
    font-family: var(--body-font);
    font-size: 0.85rem;
  }

  .sketch-switcher > span {
    opacity: 0.58;
  }

  .sketch-switcher > div {
    display: flex;
    gap: 0.75rem;
  }

  button {
    appearance: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    opacity: 0.4;
    text-underline-offset: 0.2em;
  }

  button:hover,
  button:focus-visible {
    opacity: 0.78;
  }

  button:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 0.25rem;
  }

  button[aria-checked="true"] {
    font-weight: 700;
    opacity: 1;
    text-decoration: underline;
  }
</style>
