---
import { getCollection, render } from "astro:content";
import WeekPost from "@/layouts/WeekPost.astro";
import { getWeekYearAndSlug, isPublishedWeek } from "@/lib/course-content";

export async function getStaticPaths() {
  const posts = (await getCollection("weeks")).filter(isPublishedWeek);
  return posts
    .filter((post) => post.data.week !== 0 && post.data.page !== false)
    .map((post) => {
      const { year, slug } = getWeekYearAndSlug(post.id);
      return {
        params: { year: String(year), slug },
        props: { post, year },
      };
    });
}

const { post, year } = Astro.props;
const yearNumber = Number(year);
const { Content } = await render(post);
---

<WeekPost {...post.data} year={yearNumber}>
  <Content />
</WeekPost>
